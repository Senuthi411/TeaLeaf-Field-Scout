{
  "expo": {
    "name": "TeaLeaf Field Scout",
    "slug": "tealeaf-field-scout",
    "scheme": "tealeaf-field-scout",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.tealeaf.fieldscout",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "TeaLeaf Field Scout uses the camera to photograph tea leaves for disease observations.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F7F1"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "TeaLeaf Field Scout uses the camera to photograph tea leaves for disease observations.",
          "photosPermission": "TeaLeaf Field Scout lets you choose existing leaf photos to attach to an observation.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TeaLeaf Field Scout uses your location to tag where each observation was recorded."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04c7ba63-1554-4ba1-b195-f86609db30f4"
      }
    }
  }
}
